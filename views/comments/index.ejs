<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Comments</title>
</head>
<body>
    <h1>Comments</h1>
    <ul>
        <% for(let c of comments) { %>
            <li><%= c.comment %> - <b><%= c.username %></b></li>
        <% } %>
    </ul>
    <a href="/comments/new">new comments</a>
</body>
</html>
